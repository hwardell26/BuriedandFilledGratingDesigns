import numpy as np
import meent
import matplotlib.pyplot as plt
import scipy
from scipy.optimize import minimize
from contextlib import contextmanager
from scipy.optimize import differential_evolution

n_top = 1.0
n_bot = 1000
n_film = 1.644 #alumina
n_pillar = 1.45
n_trench = 1.0 #air
theta = 61 * np.pi / 180
field_res_x = 100
field_res_z = 100
field_res_y = 100
period = [574.7]
wavelength = 1053
pol = 0
fto = 12
type_complex = np.complex128
UCELL_RES = 1000
EFI_WEIGHT = 0.06 # Increase to prioritize EFI mitigation (in silica), decrease to prioritize DE

def build_ucell(duty_cycle, pillar_height, film_thickness, x_res=UCELL_RES):
    dx = period[0] / x_res
    sidewall_px = int(round(film_thickness / dx))
    core_cutoff = int(round(x_res * duty_cycle))
    core_cutoff = np.clip(core_cutoff, 1, x_res - 1) #top film/air (top)
    pillar_cutoff2 = sidewall_px                     # left film/sio2 (middle)
    pillar_cutoff3 = core_cutoff - sidewall_px        # sio2/right film (middle)
    pillar_cutoff4 = core_cutoff                      # right film/air (middle)
    pillar_cutoff5 = sidewall_px                      # left film/sio2 (bottom)
    pillar_cutoff6 = core_cutoff - sidewall_px         # sio2/right film boundary (bottom)
    ucell_1d_m = np.ones((3, 1, x_res), dtype=type_complex)

    ucell_1d_m[0, 0, :core_cutoff] = n_film #top
    ucell_1d_m[0, 0, core_cutoff:] = n_trench
    ucell_1d_m[1, 0, :pillar_cutoff2] = n_film #middle
    ucell_1d_m[1, 0, pillar_cutoff2:pillar_cutoff3] = n_pillar
    ucell_1d_m[1, 0, pillar_cutoff3:pillar_cutoff4] = n_film
    ucell_1d_m[1, 0, pillar_cutoff4:] = n_trench
    ucell_1d_m[2, 0, :pillar_cutoff5] = n_film #bottom
    ucell_1d_m[2, 0, pillar_cutoff5:pillar_cutoff6] = n_pillar
    ucell_1d_m[2, 0, pillar_cutoff6:] = n_film

    thickness = [film_thickness, pillar_height - film_thickness, film_thickness]
    dx_field = period[0] / field_res_x
    sidewall_px_field = int(round(film_thickness / dx_field))
    core_cutoff_field = int(round(field_res_x * duty_cycle))
    core_cutoff_field = np.clip(core_cutoff_field, 1, field_res_x - 1)
    left_field = sidewall_px_field
    right_field = core_cutoff_field - sidewall_px_field

    total_thickness = sum(thickness)
    z_top = int(round(field_res_z * thickness[0] / total_thickness))
    z_mid = int(round(field_res_z * thickness[1] / total_thickness))
    z_bot = field_res_z - z_top - z_mid  

    index_map = np.ones((field_res_z, field_res_x)) * n_trench
    index_map[:z_top, :core_cutoff_field] = n_film #top 
    index_map[z_top:z_top+z_mid, :left_field] = n_film #middle
    index_map[z_top:z_top+z_mid, left_field:right_field] = n_pillar
    index_map[z_top:z_top+z_mid, right_field:core_cutoff_field] = n_film
    index_map[z_top+z_mid:, :left_field] = n_film #bottom
    index_map[z_top+z_mid:, left_field:right_field] = n_pillar
    index_map[z_top+z_mid:, right_field:] = n_film

    cutoffs = dict(core_cutoff=core_cutoff, pillar_cutoff2=pillar_cutoff2, pillar_cutoff3=pillar_cutoff3, pillar_cutoff4=pillar_cutoff4, pillar_cutoff5=pillar_cutoff5, pillar_cutoff6=pillar_cutoff6, sidewall_px_field=sidewall_px_field, core_cutoff_field=core_cutoff_field, z_top=z_top, z_mid=z_mid, z_bot=z_bot)
    return ucell_1d_m, thickness, cutoffs, index_map

def get_efi_regions(val, cutoffs):
    res_z, res_x = val.shape
    left = cutoffs['sidewall_px_field']
    right = cutoffs['core_cutoff_field'] - cutoffs['sidewall_px_field']
    core_cutoff = cutoffs['core_cutoff_field']
    z_top, z_mid = cutoffs['z_top'], cutoffs['z_mid']

    core_mask = np.zeros((res_z, res_x), dtype=bool)
    film_mask = np.zeros((res_z, res_x), dtype=bool)
    air_mask = np.zeros((res_z, res_x), dtype=bool)

    film_mask[:z_top, :core_cutoff] = True #top
    air_mask[:z_top, core_cutoff:] = True
    film_mask[z_top:z_top+z_mid, :left] = True #middle
    core_mask[z_top:z_top+z_mid, left:right] = True
    film_mask[z_top:z_top+z_mid, right:core_cutoff] = True
    air_mask[z_top:z_top+z_mid, core_cutoff:] = True
    film_mask[z_top+z_mid:, :left] = True #bottom
    core_mask[z_top+z_mid:, left:right] = True
    film_mask[z_top+z_mid:, right:] = True

    pillar_max_efi = np.max(val[core_mask]) if core_mask.any() else 0.0
    film_max_efi = np.max(val[film_mask]) if film_mask.any() else 0.0
    trench_max_efi = np.max(val[air_mask]) if air_mask.any() else 0.0
    return pillar_max_efi, film_max_efi, trench_max_efi

def calculation_fuction(duty_cycle, pillar_height, film_thickness):
    ucell_1d_m, thickness, cutoffs, index_map = build_ucell(duty_cycle, pillar_height, film_thickness)
    mee = meent.call_mee(backend=0, n_top=n_top, n_bot=n_bot, theta=theta, fto=fto, pol=pol,wavelength=wavelength, period=period, ucell=ucell_1d_m,thickness=thickness, type_complex=type_complex)
    result1, field_cell = mee.conv_solve_field(res_z=field_res_z, res_y=1, res_x=field_res_x)
    res = result1.res
    de_ri = res.de_ri_s
    de_ti = res.de_ti_s
    val = np.abs(field_cell[:, 0, :, 0])**2
    PillarMaxEFI, FilmMaxEFI, TrenchMaxEFI = get_efi_regions(val, cutoffs)
    PillarDamageFactor = PillarMaxEFI * n_pillar**3
    FilmDamageFactor = FilmMaxEFI * n_film**3

    print("total DE of reflection", de_ri.sum())
    print("total DE of transmission", de_ti.sum())
    print("Order 0 DE", de_ri[0, fto])
    print("Order -1 DE", de_ri[0, fto-1])
    print("Order 1 DE", de_ri[0, fto+1])
    print("absorption", (1-de_ti.sum())-de_ri.sum())
    print("EFI Max", np.max(val))
    print("max pillar EFI", PillarMaxEFI)
    print("max film EFI", FilmMaxEFI)
    print("trench max EFI", TrenchMaxEFI)
    print("pillar height", pillar_height)
    print("film thickness", film_thickness)
    print("LIDT metric", PillarDamageFactor)

    total_thickness = sum(thickness)
    extent = [0, period[0], total_thickness, 0]
    fig, axes = plt.subplots(1, 2, figsize=(21, 7))
    ax = axes[0]
    im1 = ax.imshow(val, cmap="jet", aspect="auto", origin="upper", extent=extent)
    ax.set_xlabel("X (nm)")
    ax.set_ylabel("Z (nm)")
    ax.set_title("EFI")
    plt.colorbar(im1, ax=ax)
    ax = axes[1]
    im2 = ax.imshow(index_map, cmap="gray", aspect="auto", origin="upper", extent=extent)
    ax.set_xlabel("X (nm)")
    ax.set_ylabel("Z (nm)")
    ax.set_title("Refractive Index Map")
    plt.colorbar(im2, ax=ax)
    plt.show()
    return de_ri, de_ti, PillarMaxEFI, FilmMaxEFI, TrenchMaxEFI


def minimization_factor(x, EFI_WEIGHT):
    duty_cycle, pillar_height, film_thickness = x
    ucell_1d_m, thickness, cutoffs, index_map = build_ucell(duty_cycle, pillar_height, film_thickness)
    mee = meent.call_mee(backend=0, n_top=n_top, n_bot=n_bot, theta=theta, fto=fto, pol=pol, wavelength=wavelength, period=period, ucell=ucell_1d_m,thickness=thickness, type_complex=type_complex)
    result1, field_cell = mee.conv_solve_field(res_z=field_res_z, res_y=1, res_x=field_res_x)
    de_ri = result1.res.de_ri_s
    de_minus1 = de_ri[0, fto-1]
    val = np.abs(field_cell[:, 0, :, 0])**2
    pillar_max_efi, film_max_efi, trench_max_efi = get_efi_regions(val, cutoffs)
    PillarDamageFactor = pillar_max_efi * n_pillar**3
    FilmDamageFactor = film_max_efi * n_film**3
    damage_factor = max(PillarDamageFactor, FilmDamageFactor)
    objective = -de_minus1 + EFI_WEIGHT * damage_factor
    print(f"duty_cycle={duty_cycle:.3f} pillar height={pillar_height:.1f} "
          f"film thickness={film_thickness:.3f} DE-1={de_minus1:.4f} damage={damage_factor:.4f}")
    return objective

def main():
    duty_cycle = 0.3
    pillar_height = 400
    film_thickness = 20
    calculation_fuction(duty_cycle, pillar_height, film_thickness)
    bounds = [(0.4, .6), (100, 1000), (10, 50)]
    result1 = differential_evolution(minimization_factor, bounds=bounds, args=(EFI_WEIGHT,),popsize=60, workers=-1, maxiter=1000, polish=True, updating="deferred")
    print(result1)
    duty_cycle = result1.x[0]
    pillar_height = result1.x[1]
    film_thickness = result1.x[2]
    print("Final structure")
    print("pillar duty cycle", duty_cycle)
    print("pillar height", pillar_height)
    print("film thickness", film_thickness)
    calculation_fuction(duty_cycle, pillar_height, film_thickness)

if __name__ == "__main__":
    main()
