def _material_index(mat_name, duty_cycle, res_x):
    if mat_name == "sio2":
        return n_sio2
    elif mat_name == "al2o3":
        return n_al3O2
    elif mat_name == "grating":
        pillar_end = int(res_x * duty_cycle)
        row = np.full(res_x, n_top)
        row[:pillar_end] = n_sio2
        return row
    else:
        raise ValueError(f"Unknown material tag: {mat_name}")


def build_index_map(thickness, duty_cycle, res_z, res_x):
    total_t = sum(thickness)
    z_pixels = [max(1, round(res_z * t / total_t)) for t in thickness]
    z_pixels[0] += res_z - sum(z_pixels)
    n_map = np.zeros((res_z, res_x))
    z0 = 0
    for mat_name, n_z in zip(material_list, z_pixels):
        z1 = z0 + n_z
        val = _material_index(mat_name, duty_cycle, res_x)
        n_map[z0:z1, :] = val
        z0 = z1
    return n_map

